PORT=3000
NODE_ENV=development
DATABASE_URL=mysql://root:password@localhost:3306/shop
DB_POOL_SIZE=10
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PAYMENT_PROVIDER_KEY=
# Email: either SMTP_URL, or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS. Leave all empty to only log emails.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@wasaahost.com
SHIPPING_FEE_CENTS=500
FREE_SHIPPING_THRESHOLD_CENTS=5000
CACHE_TTL_MS=60000
CACHE_MAX_ENTRIES=500
REDIS_URL=redis://127.0.0.1:6379
EMAIL_WORKER_CONCURRENCY=5
LOW_STOCK_THRESHOLD=5
WASAA_BASE=https://api.wasaachat.com/api/v1/core
# WasaaChat app / OAuth client id
WASAACHAT_CLIENT_ID=
# WasaaChat app secret: launch-code (code2Session) exchange, OAuth token exchange, payment verification
WASAACHAT_CODE_2_SESSION=
# whsec_… for the payments/payouts webhook at /api/wasaa/webhook
WASAACHAT_PAYOUT_SIGNING_SECRET=
WASAA_SESSION_RATE_LIMIT_MAX=30
# Sign in with WasaaChat (web). Must match a redirect URI registered in the
# WasaaChat developer console exactly, character for character.
WASAA_OAUTH_REDIRECT_URI=http://localhost:3000/auth/wasaachat/callback
WASAA_OAUTH_AUTHORIZE_URL=https://wasaachat.com/oauth/consent
WEB_SESSION_HOURS=168
# whsec_… for the Sign in with WasaaChat deauthorize webhook at /api/wasaa/deauthorize
WASAACHAT_PAYOUT_DEAUTHORIZE_SECRET=
LOG_LEVEL=info
